# Portfolio import settings.
# Copy this file to .env.import (same folder) and paste your Sanity write token
# after SANITY_WRITE_TOKEN=. .env.import is ignored by git. Never commit it.
# Never put the token in .env.local. That file is committed to git.
# The project ID and dataset below are public values and do not need changing.
SANITY_WRITE_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=00iree4d
NEXT_PUBLIC_SANITY_DATASET=production
