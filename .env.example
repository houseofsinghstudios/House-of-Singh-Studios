# Website settings. For local development, copy this file to .env.local and fill in your values.
# .env.local is local only: git ignores it (.env* in .gitignore) and it is never committed.
# On Vercel the same names are set in the project's Environment Variables settings.

# Sanity CMS. Public values (also in sanity.config.ts), so a fresh checkout builds as is.
NEXT_PUBLIC_SANITY_PROJECT_ID=00iree4d
NEXT_PUBLIC_SANITY_DATASET=production

# Site URL (optional, has fallback)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# n8n webhook URLs — form submissions and automations
# Shared secret sent to every n8n webhook in the x-hos-webhook-secret header. Required:
# without it no form or tool sends anything to n8n.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_SUBSCRIBE_WEBHOOK_URL=your_n8n_subscribe_webhook_url
N8N_CAREERS_WEBHOOK_URL=your_n8n_careers_webhook_url
# Brand Pulse events (completed, lead, profile, feedback)
N8N_BRAND_PULSE_WEBHOOK_URL=
# Project Planner events (started, viewed, call_clicked, sent)
N8N_PROJECT_PLANNER_WEBHOOK_URL=
